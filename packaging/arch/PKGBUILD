# Local source package. scripts/prepare-arch.py supplies archive and exact checksum.
pkgname=logi-center
pkgver=0.5.1
pkgrel=1
pkgdesc='Capability-driven Linux peripheral manager using existing hardware backends'
arch=('any')
url='https://github.com/Mirox921/logi-center'
license=('MIT')
depends=('python' 'python-gobject' 'python-yaml' 'pyside6' 'qt6-svg' 'qt6-declarative')
# Offline artwork tests/build tools only; no Cairo/GTK renderer at runtime.
makedepends=('python-cairo')
optdepends=(
  'qt6-wayland: native Wayland platform plugin for the QML interface'
  'libratbag: supported gaming mouse settings'
  'openrgb: optional local RGB SDK server'
  'python-openrgb: optional OpenRGB Python SDK binding (AUR)'
  'python-openrazer: optional OpenRazer API and its daemon/driver dependencies'
  'rivalcfg: optional SteelSeries scalar settings (AUR)'
  'ckb-next: optional Corsair daemon discovery'
  'piper: external mouse editor'
  'solaar: Logitech HID++ settings and explicit feature probes'
  'headsetcontrol: supported headset hardware features'
  'libpulse: pactl audio controls and parec/paplay microphone tests'
  'pipewire-pulse: PulseAudio-compatible audio server (or pulseaudio)'
  'easyeffects: software audio effects and presets'
  'python-pyudev: event-based input device detection'
  'xdg-utils: links to documentation and preset catalogs'
)
source=("logi-center-${pkgver}.tar.gz")
sha256sums=('SKIP') # Replaced by prepare-arch.py; not a network download.

check() {
  cd "$srcdir/logi-center-$pkgver"
  python -m unittest -q
  python -m compileall -q .
  # Required presentation files are copied recursively by package().
  for component in AppHeader SettingsPage AboutPage BackupsPage DisclosureItem DashboardToolbar DeviceImage StyledText DeviceEditor ControlEditor MouseButtons KeyboardEditor AudioPage AudioEndpoint CutInput CutCombo CutSlider; do
    test -f "src/logi_center/qml_ui/qml/$component.qml"
  done
  test ! -f qml_ui/gtk_backups.py
  test -f src/logi_center/qml_ui/bridge/backups.py
  test -f src/logi_center/qml_ui/bridge/backup_simulation.py
  test -f src/logi_center/qml_ui/bridge/preferences.py
  test -f src/logi_center/qml_ui/text_debug.py
  test -f src/logi_center/core/services/macro_library.py
  test -f src/logi_center/adapters/logitech/logitech_status.py
  test -f assets/mice/g502_transparent_wired.svg
  test -f assets/mice/g502_wireless.svg
  test -f assets/mice/g502_hero_side_wired_fixed.svg
  test -f assets/mice/g502_hero_side_wireless.svg
  test -f assets/mice/g502-top-wired-qt.svg
  test -f assets/mice/g502-top-wireless-qt.svg
  test -f assets/mice/g502-hero-side.svg
  test -f assets/mice/g502-hero-legacy.svg
  test -f src/logi_center/core/services/control_service.py
  test -f src/logi_center/core/devices/keyboard_layouts.py
  test -f src/logi_center/adapters/logitech/g515_layout.py
  test -f src/logi_center/adapters/logitech/g515_adapter.py
  test -f src/logi_center/qml_ui/bridge/editor.py
  test -f src/logi_center/qml_ui/bridge/audio.py
  test -f src/logi_center/qml_ui/bridge/diagnostics.py
  test -f src/logi_center/core/services/battery_service.py
  test -f src/logi_center/core/services/battery_presentation.py
  test -f assets/devices/generated/geometry.json
  test -f assets/mice/models.json
  test -f assets/mice/g502-hero.svg
  test -f src/logi_center/qml_ui/qml/K7DockPanel.qml
  test -f src/logi_center/adapters/mchose/k7_settings.py
  test -f src/logi_center/protocols/eweadn_protocol.py
  test -f assets/mice/eweadn-s9.svg
  test -f assets/mice/eweadn-s9-original.svg
  test -f src/logi_center/adapters/mchose/ace68_bindings.py
  test -f src/logi_center/adapters/mchose/ace68_advanced.py
  for component in G502ButtonPanel GenericMouseButtons MacroWindow K7DpiPanel K7ButtonPanel K7PerformancePanel NumberInput EweadnPanel G515Panel Ace68Panel Ace68Keyboard Ace68Assignments Ace68Advanced; do
    test -f "src/logi_center/qml_ui/qml/$component.qml"
  done
  for key in display-hdmi display-dp pointer-generic; do
    test -f "assets/devices/generated/$key@1x.png"
    test -f "assets/devices/generated/$key@2x.png"
  done
  test -f assets/icons/SOURCES.md
  for asset in g502.svg generic.svg k7-dock.svg k7-buttons.svg SOURCES.md; do
    test -f "assets/mice/diagrams/$asset"
  done
}

package() {
  cd "$srcdir/logi-center-$pkgver"
  install -dm755 "$pkgdir/usr/lib/logi-center" "$pkgdir/usr/bin"
  cp -r src/logi_center "$pkgdir/usr/lib/logi-center/"
  cp -r assets "$pkgdir/usr/lib/logi-center/logi_center/"
  install -m644 app.py "$pkgdir/usr/lib/logi-center/app.py"
  find "$pkgdir/usr/lib/logi-center" -type f -name '*.pyc' -delete
  find "$pkgdir/usr/lib/logi-center" -type d -name '__pycache__' -empty -delete
  printf '#!/bin/sh\nexec /usr/bin/python /usr/lib/logi-center/app.py "$@"\n' > "$pkgdir/usr/bin/logi-center"
  chmod 755 "$pkgdir/usr/bin/logi-center"
  install -Dm644 packaging/logi-center.desktop "$pkgdir/usr/share/applications/logi-center.desktop"
  install -Dm644 packaging/icons/logi-center.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/logi-center.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 README.ru.md "$pkgdir/usr/share/doc/$pkgname/README.ru.md"
  # Example only: enabling hardware access remains an explicit administrator action.
  install -Dm644 packaging/udev/70-logi-center-mchose.rules "$pkgdir/usr/share/doc/$pkgname/udev/70-logi-center-mchose.rules"
  cp -r docs "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 packaging/arch/README.md "$pkgdir/usr/share/doc/$pkgname/packaging/arch/README.md"
}
